# Copy to .env and fill in. Every variable below is read by pipeline/config.py.
# Relative paths resolve against the repo root. Never commit .env.

# LLM used by the script agent (T1b)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ElevenLabs narration (T2). Swap the voice id when Tom's clone exists.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# YouTube OAuth (T6). Both files are gitignored.
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_TOKEN=token.json

# Directories. library/, music/ and output/ are gitignored.
LIBRARY_DIR=library
MUSIC_DIR=music
OUTPUT_DIR=output
DATA_DIR=data

# Caption font for the render (T4b). Point at a bold .ttf/.otf you have.
# Windows: C:/Windows/Fonts/arialbd.ttf
# Linux:   /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
FONT_PATH=

# Optional. Defaults shown; omit to use them.
MIN_LIBRARY_CLIPS=200
CLIP_COOLDOWN_DAYS=3

# Optional. Leave empty to log only, no POST.
NOTIFY_WEBHOOK_URL=
